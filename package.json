{
  "name": "jackpot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/check-release-ui.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "smoke:providers": "tsx scripts/smoke-providers.ts",
    "simulate:mainnet": "tsx scripts/simulate-mainnet.ts",
    "simulate:solana:fork": "tsx scripts/simulate-solana-fork.ts",
    "smoke:mpc:devnet": "tsx scripts/smoke-mpc.ts",
    "demo:check": "tsx scripts/demo-check.ts",
    "start": "tsx apps/server/src/main.ts",
    "beta:provision": "tsx scripts/provision-beta.ts",
    "contract:build": "cargo build --locked --release --target wasm32-unknown-unknown -p jackpot-session",
    "dao:dev": "vite --config apps/dao/vite.config.ts",
    "dao:local": "tsx apps/dao/server.ts",
    "dao:release": "tsc --noEmit && vite build --config apps/dao/vite.config.ts --mode release && tsx scripts/check-dao-release.ts",
    "dao:serve": "tsx apps/dao/release-server.ts",
    "dao:build": "tsc --noEmit && vite build --config apps/dao/vite.config.ts",
    "dao:contract:build": "cargo build --locked --release --target wasm32-unknown-unknown -p rascals-contributor-dao",
    "dao:worker:build": "sh workers/contributor-verdict/build.sh"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.25",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.7",
    "@hot-labs/near-connect": "0.11.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@nktkas/hyperliquid": "0.33.3",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@web3icons/react": "4.1.24",
    "bs58": "^6.0.0",
    "cannon-es": "0.20.0",
    "ethers": "^6.17.0",
    "fastify": "^5.12.7",
    "lucide-react": "1.61.0",
    "near-api-js": "^7.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
