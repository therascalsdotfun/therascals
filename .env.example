# Default: private, loopback-only operator development. Never expose this mode.
JACKPOT_MODE=local
HOST=127.0.0.1
PORT=4317

# Public wallet release: exact HTTPS origin, no faucet keys required.
# JACKPOT_MODE=public
# JACKPOT_PUBLIC_ORIGIN=https://jackpot.example.com
# Optional sponsored Test Mode, requires verified WASM + dedicated faucet mounts:
# JACKPOT_BETA_SLOTS=beta01,beta02
# Slots are free to claim, so cap how many a single subscriber (one /24 or /64)
# may take per day. Default 2; 0 pauses all new claims.
# JACKPOT_BETA_CLAIMS_PER_NETWORK_PER_DAY=2
# Comma-separated wallets that may claim. Unset keeps the beta open; set it, even
# empty, to make claims invite-only.
# JACKPOT_BETA_ALLOWLIST=0xyourwallet,friend.testnet
# JACKPOT_TRUST_PROXY=1
# Who may name a client in X-Forwarded-For. 1 (or true) trusts a reverse proxy on
# this host (127.0.0.1, ::1); or list the proxy addresses/CIDRs, comma-separated.
# Unset or 0 uses the socket address only. Never enable the raw API port publicly.
# A bare number like 2, or anything that is not an IP/CIDR, fails at startup.

# Optional provider key: public/free access is attempted without it.
# JUPITER_API_KEY=
# Optional server-only NEAR Intents partner key. Public access is tried first.
# Dry quotes remain read-only; executable quotes require verified wallet ownership.
# NEAR_INTENTS_API_KEY=
# Optional server-only Solana MAINNET RPC for Intents funding (never a Devnet URL).
# SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
# Optional isolated state file, useful for QA; preserve its volume and ownership.
# JACKPOT_STATE_DB=.data/public.sqlite

# Hyperliquid perps slot. Testnet is the default; mainnet is gated on purpose.
# JACKPOT_PERPS_NETWORK=testnet
# JACKPOT_PERPS_MAINNET=1
# 32-byte hex or base64 secret encrypting trade-only agent keys at rest.
# Public modes require it (or the mounted .data/perps-secret) and refuse to boot
# without one; only local mode generates .data/perps-secret, mode 0600. Back it up.
# JACKPOT_PERPS_SECRET=
