# Copy to deploy/.env on the server and fill in. The real file stays ignored
# (.env is in .gitignore); this template is what gets committed.

# Exact browser origin. POSTs from any other Origin are rejected with 403, so
# this must match what users type: same scheme, no port, no trailing slash.
JACKPOT_PUBLIC_ORIGIN=https://therascals.fun

# Reference hostname for the operator. The shared Caddyfile contains explicit
# site names; this variable does not rewrite it or configure DNS.
JACKPOT_HOST=therascals.fun

# 1 means "a reverse proxy on this same host may name the client address".
# Required behind Caddy, otherwise every visitor shares one rate-limit budget
# taken from the proxy's IP. Never use `true`, which trusts a client-written
# X-Forwarded-For prefix.
JACKPOT_TRUST_PROXY=1

# 32 random bytes, hex or base64. Encrypts the stored delegated trading-agent
# keys. Public mode refuses to boot without it rather than inventing a key that
# cannot decrypt the agents already on disk, so generate it once, store it in a
# password manager, and back it up alongside the database.
#   openssl rand -hex 32
JACKPOT_PERPS_SECRET=

# Perps network. Testnet is the default and the only supported mode until a
# human-funded acceptance run exists; mainnet needs JACKPOT_PERPS_NETWORK=mainnet
# AND JACKPOT_PERPS_MAINNET=1.
# JACKPOT_PERPS_NETWORK=testnet

# Sponsored Test Mode is off unless you provision it. Setting slots without the
# faucet credentials mount and the verified WASM artifact makes public mode
# throw at startup, which is the intended fail-closed behaviour.
# JACKPOT_BETA_SLOTS=beta01

# Invite-only beta gate. An empty allowlist means a CLOSED beta, not an
# unlisted one, so only set this together with the addresses you want in.
# JACKPOT_BETA_ALLOWLIST=someone.near
# Claims per source network per day. 0 closes claims entirely.
# JACKPOT_BETA_CLAIMS_PER_NETWORK_PER_DAY=2

# Optional server-only provider overrides.
# SOLANA_MAINNET_RPC=
# NEAR_INTENTS_API_KEY=
