# Root-only /etc/rascals/backup.env, separate from the application's deployment env.
# 'encrypted' MUST be an rclone crypt remote wrapping the chosen off-box bucket.
# No cloud account, bucket or credentials are provisioned by this example.
BACKUP_REMOTE=encrypted:rascals-recovery
RCLONE_CONFIG=/etc/rascals/rclone.conf
BACKUP_VOLUME=/var/lib/docker/volumes/jackpot-state/_data
BACKUP_ENV_FILE=/opt/rascals/repo/deploy/.env
BACKUP_LOCK=/run/rascals-backup/backup.lock
